{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "src/**"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/index.ts" },
    { "source": "/api/problem-types", "destination": "/api/index.ts" },
    { "source": "/api/(.*)", "destination": "/api/index.ts" }
  ]
}
