{
  "installCommand": "npm install",
  "buildCommand": "npm --workspace @iluminaxingu/web run build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/prefeitura", "destination": "/index.html" },
    { "source": "/prefeitura/(.*)", "destination": "/index.html" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
